{
  "name": "geocode-api",
  "version": "1.1.0",
  "description": "API for querying administrative boundary data from parquet files",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --watch src/index.ts",
    "download": "node scripts/download.js",
    "check-types": "tsc --noEmit",
    "test": "npm run build && node --test \"test/**/*.test.js\"",
    "integration-test": "npm run build && node --test test/integration.test.js"
  },
  "keywords": [
    "geocode",
    "reverse-geocode",
    "duckdb",
    "whosonfirst"
  ],
  "author": "Russell Porter",
  "license": "MIT",
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.4",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2"
  }
}
